<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PdfStudio.App.ViewModels"
        xmlns:themes="using:PdfStudio.App.Themes"
        xmlns:controls="using:PdfStudio.App.Controls"
        xmlns:editors="using:PdfStudio.App.Views.Editors"
        xmlns:docs="using:PdfStudio.Core.Documents"
        xmlns:forms="using:PdfStudio.Core.Forms"
        x:Class="PdfStudio.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Document Studio"
        Icon="avares://PdfStudio/Assets/app.ico"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        UseLayoutRounding="True"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource CanvasBackgroundBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenSearchBarCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding NextSearchMatchCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding PreviousSearchMatchCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding HandleEscapeCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetZoomCommand}" />
    <KeyBinding Gesture="Alt+D1" Command="{Binding FitToWidthCommand}" />
    <KeyBinding Gesture="Alt+D2" Command="{Binding FitToPageCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleNewTabMenuCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding ReopenClosedTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding ToggleAllTabsDropdownCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding SelectTabByNumberCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding SelectTabByNumberCommand}" CommandParameter="2" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding SelectTabByNumberCommand}" CommandParameter="3" />
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding SelectTabByNumberCommand}" CommandParameter="4" />
    <KeyBinding Gesture="Ctrl+D5" Command="{Binding SelectTabByNumberCommand}" CommandParameter="5" />
    <KeyBinding Gesture="Ctrl+D6" Command="{Binding SelectTabByNumberCommand}" CommandParameter="6" />
    <KeyBinding Gesture="Ctrl+D7" Command="{Binding SelectTabByNumberCommand}" CommandParameter="7" />
    <KeyBinding Gesture="Ctrl+D8" Command="{Binding SelectTabByNumberCommand}" CommandParameter="8" />
    <KeyBinding Gesture="Ctrl+D9" Command="{Binding SelectTabByNumberCommand}" CommandParameter="9" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveDocumentAsCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding RotateSelectedRightCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding RotateSelectedLeftCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+T" Command="{Binding ToggleThemePickerCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="40,Auto,*">

    <!-- 40px Browser-Style Integrated Titlebar & Tab Strip -->
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource HairlineBorderBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="TitleBar_OnPointerPressed"
            DoubleTapped="TitleBar_OnDoubleTapped">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- Brand Mark -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="12,0,8,0" VerticalAlignment="Center">
          <Border Width="22"
                  Height="22"
                  CornerRadius="6"
                  Background="{DynamicResource AccentBrush}">
            <Path Data="{StaticResource IconFileText}"
                  Stroke="{DynamicResource AccentTextBrush}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Fill="Transparent"
                  Stretch="Uniform"
                  Width="12"
                  Height="12"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Document Studio"
                     Classes="type-control"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center"
                     IsVisible="{Binding !HasOpenDocument}" />
        </StackPanel>

        <!-- Browser Tab Strip + Overflow Chevrons + '+' New Tab + 'v' All Tabs + Grab Space -->
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto,64" VerticalAlignment="Bottom">
          <Button x:Name="TabScrollLeftBtn"
                  Grid.Column="0"
                  Classes="linear-ghost icon-btn"
                  Click="TabScrollLeft_OnClick"
                  IsVisible="False"
                  Margin="0,0,2,4"
                  ToolTip.Tip="Scroll tabs left">
            <Path Classes="icon-stroke" Data="{StaticResource IconChevronLeft}" Width="12" Height="12" />
          </Button>

          <ScrollViewer x:Name="TabStripScroll"
                        Grid.Column="1"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        SizeChanged="TabStripScroll_OnSizeChanged">
            <ItemsControl x:Name="BrowserTabItemsControl"
                          ItemsSource="{Binding OpenTabs}"
                          PointerMoved="BrowserTabItemsControl_OnPointerMoved"
                          PointerReleased="BrowserTabItemsControl_OnPointerReleased">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DocumentTabViewModel">
                  <Border Classes="browser-tab"
                          Classes.active="{Binding IsActive}"
                          Classes.dirty="{Binding IsDirty}"
                          Classes.pinned="{Binding IsPinned}"
                          Width="{Binding TabPillWidth}"
                          PointerPressed="BrowserTab_OnPointerPressed">
                    <ToolTip.Tip>
                      <StackPanel Spacing="3" MaxWidth="360">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Text="{Binding OriginalFilePath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                          <TextBlock Text="{Binding FormatDisplayName}" FontSize="11" FontWeight="Medium" />
                          <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                          <TextBlock Text="{Binding LastModifiedDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </ToolTip.Tip>

                    <Border.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="Pin / Unpin Tab"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TogglePinTabCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Duplicate Tab"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DuplicateTabCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Copy Full Path"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyTabFullPathCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Reveal in File Explorer"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RevealInExplorerCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Close"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Close Other Tabs"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseOtherTabsCommand}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Close Tabs to the Right"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabsToRightCommand}"
                                  CommandParameter="{Binding}" />
                      </MenuFlyout>
                    </Border.ContextFlyout>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                      <!-- Pin Icon + Color-Coded Format Badge -->
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Path Classes="icon-stroke"
                              Data="{StaticResource IconPin}"
                              Stroke="{DynamicResource AccentBrush}"
                              Width="10"
                              Height="10"
                              IsVisible="{Binding IsPinned}" />
                        <Border Background="{Binding FormatBadgeBackgroundBrush}"
                                CornerRadius="4"
                                Padding="4,1"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding FormatBadgeText}"
                                     Foreground="{Binding FormatBadgeBrush}"
                                     FontSize="9.5"
                                     FontWeight="Bold" />
                        </Border>
                      </StackPanel>

                      <!-- Bold Filename -->
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Title}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />

                      <!-- Micro-Metadata Badge + Read-Only Lock -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Path Classes="icon-stroke"
                              Data="{StaticResource IconLock}"
                              Width="10"
                              Height="10"
                              IsVisible="{Binding IsReadOnly}"
                              ToolTip.Tip="Read-Only" />
                        <Border IsVisible="{Binding HasMicroMetadata}"
                                Background="{DynamicResource PanelSubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4,0">
                          <TextBlock Text="{Binding MicroMetadataBadge}"
                                     FontSize="10"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     VerticalAlignment="Center" />
                        </Border>
                      </StackPanel>

                      <!-- Unsaved Accent Dot + Hover Close '×' Button -->
                      <Grid Grid.Column="3" Width="18" Height="18" VerticalAlignment="Center">
                        <Ellipse Classes="tab-dirty-dot"
                                 Width="7"
                                 Height="7"
                                 Fill="{DynamicResource WarningBrush}"
                                 IsVisible="{Binding IsDirty}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Button Classes="linear-ghost tab-close-btn"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                CommandParameter="{Binding}"
                                Width="18"
                                Height="18"
                                Padding="0"
                                ToolTip.Tip="Close (Ctrl+W)">
                          <Path Classes="icon-stroke" Data="{StaticResource IconCloseWin}" Width="9" Height="9" />
                        </Button>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Button x:Name="TabScrollRightBtn"
                  Grid.Column="2"
                  Classes="linear-ghost icon-btn"
                  Click="TabScrollRight_OnClick"
                  IsVisible="False"
                  Margin="2,0,2,4"
                  ToolTip.Tip="Scroll tabs right">
            <Path Classes="icon-stroke" Data="{StaticResource IconChevronRight}" Width="12" Height="12" />
          </Button>

          <!-- '+' New / Open Tab Button -->
          <Button Grid.Column="3"
                  Classes="linear-ghost icon-btn"
                  Classes.active="{Binding IsNewTabMenuOpen}"
                  Command="{Binding ToggleNewTabMenuCommand}"
                  Margin="2,0,2,4"
                  ToolTip.Tip="New / Open Tab (Ctrl+T)">
            <Path Classes="icon-stroke" Data="{StaticResource IconPlus}" Width="13" Height="13" />
          </Button>

          <!-- 'v' All Open Tabs Search Dropdown Button -->
          <Button Grid.Column="4"
                  Classes="linear-ghost icon-btn"
                  Classes.active="{Binding IsAllTabsDropdownOpen}"
                  Command="{Binding ToggleAllTabsDropdownCommand}"
                  IsVisible="{Binding HasOpenDocument}"
                  Margin="0,0,2,4"
                  ToolTip.Tip="Search All Open Tabs (Ctrl+Shift+A)">
            <Path Classes="icon-stroke" Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
          </Button>

          <!-- Draggable Window-Grab Space after '+' / 'v' -->
          <Border Grid.Column="5"
                  Background="Transparent"
                  Height="40" />
        </Grid>

        <!-- Right: Undo / Redo / Find / Theme Switcher + Native Windows Caption Buttons -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
            <Button Classes="linear-ghost icon-btn"
                    Command="{Binding UndoCommand}"
                    IsVisible="{Binding HasOpenDocument}"
                    ToolTip.Tip="Undo (Ctrl+Z)">
              <Path Classes="icon-stroke" Data="{StaticResource IconUndo}" Width="14" Height="14" />
            </Button>
            <Button Classes="linear-ghost icon-btn"
                    Command="{Binding RedoCommand}"
                    IsVisible="{Binding HasOpenDocument}"
                    ToolTip.Tip="Redo (Ctrl+Y)">
              <Path Classes="icon-stroke" Data="{StaticResource IconRedo}" Width="14" Height="14" />
            </Button>
            <Button Classes="linear-ghost icon-btn"
                    Classes.active="{Binding IsSearchBarOpen}"
                    Command="{Binding OpenSearchBarCommand}"
                    IsVisible="{Binding HasOpenDocument}"
                    ToolTip.Tip="Find (Ctrl+F)">
              <Path Classes="icon-stroke" Data="{StaticResource IconSearch}" Width="14" Height="14" />
            </Button>

            <Button Classes="linear-ghost"
                    Classes.active="{Binding IsThemePickerOpen}"
                    Command="{Binding ToggleThemePickerCommand}"
                    Height="26"
                    Padding="8,4"
                    ToolTip.Tip="Themes (Ctrl+Alt+T)">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="8"
                         Height="8"
                         Fill="{Binding SelectedThemeAccentBrush}"
                         Stroke="{DynamicResource FloatingBorderBrush}"
                         StrokeThickness="1"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedTheme.Name}"
                           Classes="type-micro"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Path Classes="icon-stroke" Data="{StaticResource IconChevronDown}" Width="11" Height="11" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Border Width="1"
                  Height="16"
                  Background="{DynamicResource HairlineBorderBrush}"
                  Margin="0,0,4,0" />

          <Button Classes="caption-btn" Click="MinimizeButton_OnClick" ToolTip.Tip="Minimize">
            <Path Data="{StaticResource IconMinimizeWin}"
                  Stroke="{Binding $parent[TemplatedControl].Foreground}"
                  StrokeThickness="1.25"
                  StrokeLineCap="Round"
                  Stretch="None"
                  Width="12"
                  Height="10"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Button>
          <Button Classes="caption-btn" Click="MaximizeButton_OnClick" ToolTip.Tip="Maximize">
            <Path Classes="icon-stroke" Data="{StaticResource IconMaximizeWin}" Width="11" Height="11" />
          </Button>
          <Button Classes="caption-btn caption-close" Click="CloseButton_OnClick" ToolTip.Tip="Close">
            <Path Classes="icon-stroke" Data="{StaticResource IconCloseWin}" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 32px Sub-Header Context Strip (Breadcrumbs, Live Format Status & Quick Save / Export PDF Pills) -->
    <Border Grid.Row="1"
            Height="32"
            IsVisible="{Binding HasOpenDocument}"
            Background="{DynamicResource FloatingToolbarBrush}"
            BorderBrush="{DynamicResource HairlineBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,0">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Clickable Folder Path Breadcrumb -->
        <ScrollViewer Grid.Column="0"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding ActiveTab.BreadcrumbSegments}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BreadcrumbSegment">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Classes="linear-ghost"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BreadcrumbNavigateCommand}"
                          CommandParameter="{Binding}"
                          Padding="5,2"
                          Height="22"
                          ToolTip.Tip="{Binding FullPath}">
                    <TextBlock Text="{Binding Label}"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Button>
                  <TextBlock Text="›"
                             FontSize="12"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !IsLast}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Live Format Status + Quick Save & Export PDF Pills -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding ContextBarStatusText}"
                     Classes="mono-micro"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,4,0" />

          <Button Classes="save-pill"
                  Classes.dirty="{Binding HasUnsavedChanges}"
                  Command="{Binding SaveDocumentCommand}"
                  Height="22"
                  Padding="9,2"
                  ToolTip.Tip="Save (Ctrl+S)">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Path Classes="icon-stroke" Data="{StaticResource IconSave}" Width="11" Height="11" />
              <TextBlock Text="Save" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="linear-surface"
                  Command="{Binding ExportToPdfCommand}"
                  IsVisible="{Binding CanExportPdf}"
                  Height="22"
                  Padding="9,2"
                  ToolTip.Tip="Export to PDF">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Path Classes="icon-stroke" Data="{StaticResource IconDownload}" Width="11" Height="11" />
              <TextBlock Text="Export PDF" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 3-Pane Workspace -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">

      <!-- Left Collapsible Sidebar: Pages & Outline (PDF only) -->
      <Border Grid.Column="0"
              IsVisible="{Binding IsPdfWorkspaceActive}"
              Classes="sidebar-left"
              Classes.collapsed="{Binding !IsLeftPanelOpen}"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource HairlineBorderBrush}"
              BorderThickness="0,0,1,0"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*" Width="{Binding LeftSidebarWidth}">
          <Border Grid.Row="0"
                  Padding="12,12,12,8"
                  BorderBrush="{DynamicResource HairlineBorderBrush}"
                  BorderThickness="0,0,0,1">
            <Border Background="{DynamicResource PanelSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="2">
              <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0"
                        Classes="linear-ghost"
                        Classes.active="{Binding IsPagesTabActive}"
                        Command="{Binding SelectPagesTabCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="6,4">
                  <TextBlock Text="Pages" Classes="type-micro" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button Grid.Column="1"
                        Classes="linear-ghost"
                        Classes.active="{Binding IsOutlineTabActive}"
                        Command="{Binding SelectOutlineTabCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="6,4">
                  <TextBlock Text="Outline" Classes="type-micro" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
              </Grid>
            </Border>
          </Border>

          <Border Grid.Row="1"
                  Padding="8,6"
                  BorderBrush="{DynamicResource HairlineBorderBrush}"
                  BorderThickness="0,0,0,1"
                  IsVisible="{Binding IsPagesTabActive}">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" IsEnabled="{Binding HasOpenDocument}">
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding RotateSelectedLeftCommand}"
                      ToolTip.Tip="Rotate Left (Ctrl+Shift+L)">
                <Path Classes="icon-stroke" Data="{StaticResource IconRotateCcw}" Width="14" Height="14" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding RotateSelectedRightCommand}"
                      ToolTip.Tip="Rotate Right (Ctrl+Shift+R)">
                <Path Classes="icon-stroke" Data="{StaticResource IconRotateCw}" Width="14" Height="14" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding DeleteSelectedPageCommand}"
                      ToolTip.Tip="Delete Page (Del)">
                <Path Classes="icon-stroke" Data="{StaticResource IconTrash}" Width="14" Height="14" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding ExtractSelectedPageCommand}"
                      ToolTip.Tip="Extract">
                <Path Classes="icon-stroke" Data="{StaticResource IconScissors}" Width="14" Height="14" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding MergeDocumentsCommand}"
                      ToolTip.Tip="Merge">
                <Path Classes="icon-stroke" Data="{StaticResource IconMerge}" Width="14" Height="14" />
              </Button>
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="2" Padding="12">
            <StackPanel Spacing="8">
              <StackPanel IsVisible="{Binding IsPagesTabActive}" Spacing="8">
                <ItemsControl x:Name="ThumbnailItemsControl"
                              ItemsSource="{Binding PageThumbnails}"
                              IsVisible="{Binding HasOpenDocument}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageThumbnailViewModel">
                      <StackPanel Spacing="4"
                                  Background="Transparent"
                                  PointerPressed="ThumbnailCard_OnPointerPressed"
                                  PointerMoved="ThumbnailCard_OnPointerMoved"
                                  PointerReleased="ThumbnailCard_OnPointerReleased">
                        <Border Height="2"
                                CornerRadius="1"
                                Background="{DynamicResource AccentBrush}"
                                IsVisible="{Binding IsDropTargetBefore}" />

                        <Border CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{DynamicResource PanelSubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource HairlineBorderBrush}"
                                BorderThickness="1"
                                Padding="8"
                                Cursor="Hand">
                          <Border.ContextFlyout>
                            <MenuFlyout>
                              <MenuItem Header="Insert Blank Page After"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InsertBlankPageAfterCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="Insert PDF After…"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InsertPdfAfterCommand}"
                                        CommandParameter="{Binding}" />
                              <Separator />
                              <MenuItem Header="Extract Page(s)…"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExtractSelectedPageCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="Rotate Left"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RotateSelectedLeftCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="Rotate Right"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RotateSelectedRightCommand}"
                                        CommandParameter="{Binding}" />
                              <Separator />
                              <MenuItem Header="Delete"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteSelectedPageCommand}"
                                        CommandParameter="{Binding}" />
                            </MenuFlyout>
                          </Border.ContextFlyout>
                          <StackPanel Spacing="6">
                            <Border Height="2"
                                    CornerRadius="1"
                                    Background="{DynamicResource AccentBrush}"
                                    IsVisible="{Binding IsSelected}" />

                            <Border Background="#FFFFFF"
                                    BorderBrush="{DynamicResource PageBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    BoxShadow="{StaticResource PageDropShadow}"
                                    MinHeight="96"
                                    MaxHeight="132"
                                    HorizontalAlignment="Center"
                                    Padding="2">
                              <Grid>
                                <Image Source="{Binding ThumbnailBitmap}"
                                       Stretch="Uniform"
                                       MaxHeight="128"
                                       UseLayoutRounding="True"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                              </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding DisplayNumber, StringFormat='Page {0}'}"
                                         Classes="type-micro"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         VerticalAlignment="Center" />
                              <Border Grid.Column="1"
                                      Background="{DynamicResource AccentSubtleBrush}"
                                      CornerRadius="{StaticResource BadgeCornerRadius}"
                                      Padding="4,1"
                                      IsVisible="{Binding HasRotation}"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding RotationBadge}"
                                           Classes="mono-micro"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10" />
                              </Border>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding DimensionLabel}"
                                         Classes="mono-micro"
                                         FontSize="10"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </StackPanel>
                        </Border>

                        <Border Height="2"
                                CornerRadius="1"
                                Background="{DynamicResource AccentBrush}"
                                IsVisible="{Binding IsDropTargetAfter}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border IsVisible="{Binding !HasOpenDocument}"
                        Background="{DynamicResource PanelSubtleBackgroundBrush}"
                        BorderBrush="{DynamicResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Height="120"
                        Padding="12">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <Path Classes="icon-stroke"
                          Data="{StaticResource IconLayers}"
                          Stroke="{DynamicResource TextTertiaryBrush}"
                          Width="18"
                          Height="18" />
                    <TextBlock Text="Pages"
                               Classes="type-micro"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsOutlineTabActive}" Spacing="6">
                <ItemsControl ItemsSource="{Binding OutlineNodes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="docs:PdfOutlineNode">
                      <Button Classes="linear-ghost"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectOutlineNodeCommand}"
                              CommandParameter="{Binding}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="8,6">
                        <TextBlock Text="{Binding Title}"
                                   Classes="type-body"
                                   TextTrimming="CharacterEllipsis" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border IsVisible="{Binding !OutlineNodes.Count}"
                        Background="{DynamicResource PanelSubtleBackgroundBrush}"
                        BorderBrush="{DynamicResource HairlineBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="12">
                  <TextBlock Text="No bookmarks"
                             Classes="type-micro"
                             HorizontalAlignment="Center" />
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Main Document Canvas -->
      <Grid Grid.Column="1"
            Background="{DynamicResource CanvasBackgroundBrush}"
            PointerMoved="Canvas_OnPointerMoved">

        <!-- Start View: Drop Zone, Quick Create & Recent Files -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource HairlineBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource FloatingCornerRadius}"
                BoxShadow="{DynamicResource FloatingShadow}"
                Padding="28,24"
                Width="500"
                IsVisible="{Binding !HasOpenDocument}">
          <StackPanel Spacing="18">
            <Border Background="{DynamicResource PanelSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="20,22">
              <StackPanel Spacing="14" HorizontalAlignment="Center">
                <Border Width="42"
                        Height="42"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource AccentSubtleBrush}"
                        HorizontalAlignment="Center">
                  <Path Data="{StaticResource IconFileText}"
                        Stroke="{DynamicResource AccentBrush}"
                        StrokeThickness="1.5"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Fill="Transparent"
                        Stretch="Uniform"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Text="Multi-Format Document Studio" Classes="type-section" HorizontalAlignment="Center" />
                  <TextBlock Text="Drop PDF, Excel, CSV, Word, Markdown, Text, or Image — or press Ctrl+O"
                             Classes="type-micro"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <Button Classes="linear-accent"
                          Command="{Binding OpenDocumentCommand}"
                          Padding="18,8"
                          ToolTip.Tip="Open File (Ctrl+O)">
                    <TextBlock Text="Open File…" VerticalAlignment="Center" />
                  </Button>
                  <Button Classes="linear-surface"
                          Command="{Binding NewMarkdownDocumentCommand}"
                          Padding="12,8"
                          ToolTip.Tip="New Markdown Document">
                    <TextBlock Text="+ Markdown" VerticalAlignment="Center" />
                  </Button>
                  <Button Classes="linear-surface"
                          Command="{Binding NewSpreadsheetDocumentCommand}"
                          Padding="12,8"
                          ToolTip.Tip="New Spreadsheet">
                    <TextBlock Text="+ Sheet" VerticalAlignment="Center" />
                  </Button>
                  <Button Classes="linear-surface"
                          Command="{Binding NewRichDocumentCommand}"
                          Padding="12,8"
                          ToolTip.Tip="New Word Document">
                    <TextBlock Text="+ Doc" VerticalAlignment="Center" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Recent Files -->
            <StackPanel Spacing="8" IsVisible="{Binding HasRecentFiles}">
              <TextBlock Text="RECENT"
                         Classes="type-micro"
                         Foreground="{DynamicResource TextTertiaryBrush}" />
              <ScrollViewer MaxHeight="200">
                <ItemsControl ItemsSource="{Binding RecentFiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="themes:RecentFileEntry">
                      <Border Classes="recent-item"
                              CornerRadius="{StaticResource ControlCornerRadius}"
                              Background="{DynamicResource PanelSubtleBackgroundBrush}"
                              BorderBrush="{DynamicResource HairlineBorderBrush}"
                              BorderThickness="1"
                              Padding="8,6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <Button Grid.Column="0"
                                  Classes="linear-ghost"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecentFileCommand}"
                                  CommandParameter="{Binding}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="4,2">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                              <Border Grid.Column="0"
                                      Background="{Binding FormatBadgeBackgroundBrush}"
                                      CornerRadius="4"
                                      Padding="5,2"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormatBadgeText}"
                                           Foreground="{Binding FormatBadgeBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                              </Border>
                              <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="{Binding FileName}"
                                           Classes="type-control"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ParentFolder}"
                                           Classes="type-micro"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SubtitleLabel}"
                                           Classes="mono-micro"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding LastOpenedDisplay}"
                                           Classes="type-micro"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Right" />
                              </StackPanel>
                            </Grid>
                          </Button>
                          <Button Grid.Column="1"
                                  Classes="linear-ghost icon-btn recent-remove-btn"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRecentFileCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Remove from Recent"
                                  VerticalAlignment="Center">
                            <Path Classes="icon-stroke" Data="{StaticResource IconCloseWin}" Width="11" Height="11" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Crisp PDF Canvas (mounted when PDF workspace is active) -->
        <controls:PdfCanvasControl x:Name="PdfCanvas"
                                   UseLayoutRounding="True"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   IsVisible="{Binding IsPdfWorkspaceActive}">
          <controls:PdfCanvasControl.ContextFlyout>
            <MenuFlyout>
              <MenuItem Header="Copy Text"
                        Command="{Binding CopyPageTextCommand}" />
              <MenuItem Header="Highlight Selection"
                        Command="{Binding HighlightAtContextCommand}" />
              <MenuItem Header="Add Note Here"
                        Command="{Binding AddNoteAtContextCommand}" />
              <Separator />
              <MenuItem Header="Rotate Page"
                        Command="{Binding RotateSelectedRightCommand}" />
              <MenuItem Header="Zoom to Fit"
                        Command="{Binding FitToPageCommand}" />
            </MenuFlyout>
          </controls:PdfCanvasControl.ContextFlyout>
        </controls:PdfCanvasControl>

        <!-- Polymorphic Editor Host (only the active non-PDF tab's view is mounted in the visual tree) -->
        <ContentControl x:Name="NonPdfWorkspaceHost"
                        Content="{Binding ActiveNonPdfTab}"
                        IsVisible="{Binding ActiveNonPdfTab, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type vm:SpreadsheetWorkspaceViewModel}">
              <editors:SpreadsheetEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RichDocWorkspaceViewModel}">
              <editors:RichDocEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MarkdownTextWorkspaceViewModel}">
              <editors:MarkdownTextEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImageWorkspaceViewModel}">
              <editors:ImageEditorView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- PDF Text Selection Pill & Inline Text Edit Host -->
        <Canvas IsVisible="{Binding IsPdfWorkspaceActive}">
          <!-- Selection Action Pill (Copy / Highlight / Underline / Strikeout / Redact) -->
          <Border Canvas.Left="{Binding PdfSelectionPillX}"
                  Canvas.Top="{Binding PdfSelectionPillY}"
                  IsVisible="{Binding IsPdfSelectionPillVisible}"
                  Background="{DynamicResource FloatingToolbarBrush}"
                  BorderBrush="{DynamicResource FloatingBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  BoxShadow="{DynamicResource FloatingPanelShadow}"
                  Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="linear-ghost"
                      Command="{Binding CopySelectedPdfTextCommand}"
                      Height="26"
                      Padding="8,0"
                      ToolTip.Tip="Copy (Ctrl+C)">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Classes="icon-stroke" Data="{StaticResource IconCopy}" Width="12" Height="12" />
                  <TextBlock Text="Copy" FontSize="11.5" FontWeight="Medium" />
                </StackPanel>
              </Button>
              <Button Classes="linear-ghost"
                      Command="{Binding ApplySelectionHighlightCommand}"
                      Height="26"
                      Padding="8,0"
                      ToolTip.Tip="Highlight Selection">
                <TextBlock Text="Highlight" FontSize="11.5" Foreground="#EAB308" FontWeight="SemiBold" />
              </Button>
              <Button Classes="linear-ghost"
                      Command="{Binding ApplySelectionUnderlineCommand}"
                      Height="26"
                      Padding="8,0"
                      ToolTip.Tip="Underline Selection">
                <TextBlock Text="Underline" FontSize="11.5" TextDecorations="Underline" />
              </Button>
              <Button Classes="linear-ghost"
                      Command="{Binding ApplySelectionStrikeoutCommand}"
                      Height="26"
                      Padding="8,0"
                      ToolTip.Tip="Strikeout Selection">
                <TextBlock Text="Strike" FontSize="11.5" TextDecorations="Strikethrough" />
              </Button>
              <Button Classes="linear-ghost"
                      Command="{Binding ApplySelectionRedactCommand}"
                      Height="26"
                      Padding="8,0"
                      ToolTip.Tip="Mark Selection for Redaction">
                <TextBlock Text="Redact" FontSize="11.5" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
              </Button>
            </StackPanel>
          </Border>

          <!-- In-Place PDF Text Edit Overlay (EditText 'E' tool) -->
          <Border Canvas.Left="{Binding InlinePdfTextEditX}"
                  Canvas.Top="{Binding InlinePdfTextEditY}"
                  IsVisible="{Binding IsInlinePdfTextEditOpen}"
                  Background="{DynamicResource FloatingToolbarBrush}"
                  BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="1.5"
                  CornerRadius="6"
                  BoxShadow="{DynamicResource FloatingPanelShadow}"
                  Padding="6">
            <StackPanel Spacing="6">
              <TextBox x:Name="InlinePdfTextEditBox"
                       Text="{Binding InlinePdfTextEditValue, Mode=TwoWay}"
                       Width="{Binding InlinePdfTextEditWidth}"
                       MinHeight="{Binding InlinePdfTextEditHeight}"
                       FontSize="{Binding InlinePdfTextEditFontSizePx}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       KeyDown="InlinePdfTextEditBox_OnKeyDown" />
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button Content="Delete"
                        Command="{Binding DeleteInlinePdfTextBlockCommand}"
                        Classes="linear-ghost"
                        Foreground="{DynamicResource DangerBrush}"
                        Height="24"
                        Padding="8,0" />
                <Button Content="Cancel"
                        Command="{Binding CancelInlinePdfTextEditCommand}"
                        Classes="linear-ghost"
                        Height="24"
                        Padding="8,0" />
                <Button Content="Apply"
                        Command="{Binding CommitInlinePdfTextEditCommand}"
                        Classes="linear-accent"
                        Height="24"
                        Padding="10,0" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Canvas>

        <!-- Floating Inline Form Field Editor -->
        <Border x:Name="InlineFormEditorHost"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsVisible="False"
                Background="{DynamicResource FloatingToolbarBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="4"
                Padding="2">
          <TextBox x:Name="InlineFormTextBox"
                   FontSize="12"
                   Background="Transparent"
                   BorderThickness="0"
                   LostFocus="InlineFormTextBox_OnLostFocus"
                   KeyDown="InlineFormTextBox_OnKeyDown" />
        </Border>

        <!-- Floating Find Bar (Ctrl+F) -->
        <Border Classes="floating-toolbar"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,16,0"
                IsVisible="{Binding IsSearchBarOpen}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Classes="icon-stroke"
                  Data="{StaticResource IconSearch}"
                  Stroke="{DynamicResource TextSecondaryBrush}"
                  Width="14"
                  Height="14"
                  Margin="4,0,0,0" />
            <TextBox x:Name="DocumentSearchBox"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="Find…"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="13"
                     Width="170"
                     VerticalAlignment="Center" />
            <Border Background="{DynamicResource PanelSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BadgeCornerRadius}"
                    Padding="6,2"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding SearchCounterText}" Classes="mono-micro" />
            </Border>
            <Button Classes="linear-ghost icon-btn"
                    Command="{Binding PreviousSearchMatchCommand}"
                    ToolTip.Tip="Previous (Shift+F3)">
              <Path Classes="icon-stroke" Data="{StaticResource IconChevronUp}" />
            </Button>
            <Button Classes="linear-ghost icon-btn"
                    Command="{Binding NextSearchMatchCommand}"
                    ToolTip.Tip="Next (F3)">
              <Path Classes="icon-stroke" Data="{StaticResource IconChevronDown}" />
            </Button>
            <Button Classes="linear-ghost icon-btn"
                    Command="{Binding CloseSearchBarCommand}"
                    ToolTip.Tip="Close (Esc)">
              <Path Classes="icon-stroke" Data="{StaticResource IconCloseWin}" Width="12" Height="12" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Floating Bottom Toast, Tool Properties Pill & Bottom Tool Dock -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,16"
                    Spacing="8">

          <!-- 2-Second Status Toast Pill -->
          <Border Classes="floating-toolbar"
                  HorizontalAlignment="Center"
                  Padding="12,6"
                  IsHitTestVisible="False"
                  IsVisible="{Binding IsToastVisible}">
            <TextBlock Text="{Binding ToastMessage}"
                       Classes="type-micro"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </Border>

          <!-- Contextual Tool Properties Pill (visible only when annotation tool is active) -->
          <Border Classes="floating-toolbar"
                  HorizontalAlignment="Center"
                  Padding="10,6"
                  IsVisible="{Binding IsAnnotationToolActive}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <!-- Color Swatches -->
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsToolColorYellow}"
                      Command="{Binding SetToolColorCommand}"
                      CommandParameter="#FACC15"
                      ToolTip.Tip="Yellow">
                <Ellipse Width="12" Height="12" Fill="#FACC15" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsToolColorBlue}"
                      Command="{Binding SetToolColorCommand}"
                      CommandParameter="#3B82F6"
                      ToolTip.Tip="Blue">
                <Ellipse Width="12" Height="12" Fill="#3B82F6" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsToolColorRed}"
                      Command="{Binding SetToolColorCommand}"
                      CommandParameter="#EF4444"
                      ToolTip.Tip="Red">
                <Ellipse Width="12" Height="12" Fill="#EF4444" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsToolColorGreen}"
                      Command="{Binding SetToolColorCommand}"
                      CommandParameter="#10B981"
                      ToolTip.Tip="Green">
                <Ellipse Width="12" Height="12" Fill="#10B981" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsToolColorPurple}"
                      Command="{Binding SetToolColorCommand}"
                      CommandParameter="#A855F7"
                      ToolTip.Tip="Purple">
                <Ellipse Width="12" Height="12" Fill="#A855F7" />
              </Button>

              <!-- Stroke Thickness (Highlight / Underline / Draw) -->
              <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsStrokeToolActive}">
                <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="4,0" />
                <Button Classes="linear-ghost"
                        Classes.active="{Binding IsStroke1Pt}"
                        Command="{Binding SetStrokeWidthCommand}"
                        CommandParameter="1"
                        Padding="6,3"
                        ToolTip.Tip="Thin (1pt)">
                  <TextBlock Text="1pt" Classes="mono-micro" />
                </Button>
                <Button Classes="linear-ghost"
                        Classes.active="{Binding IsStroke2Pt}"
                        Command="{Binding SetStrokeWidthCommand}"
                        CommandParameter="2"
                        Padding="6,3"
                        ToolTip.Tip="Medium (2pt)">
                  <TextBlock Text="2pt" Classes="mono-micro" />
                </Button>
                <Button Classes="linear-ghost"
                        Classes.active="{Binding IsStroke4Pt}"
                        Command="{Binding SetStrokeWidthCommand}"
                        CommandParameter="4"
                        Padding="6,3"
                        ToolTip.Tip="Bold (4pt)">
                  <TextBlock Text="4pt" Classes="mono-micro" />
                </Button>
              </StackPanel>

              <!-- Font Size (Text / Note) -->
              <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsTextOrNoteToolActive}">
                <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="4,0" />
                <Button Classes="linear-ghost"
                        Classes.active="{Binding IsFontSize10}"
                        Command="{Binding SetFontSizeCommand}"
                        CommandParameter="10"
                        Padding="6,3"
                        ToolTip.Tip="10 pt">
                  <TextBlock Text="10" Classes="mono-micro" />
                </Button>
                <Button Classes="linear-ghost"
                        Classes.active="{Binding IsFontSize12}"
                        Command="{Binding SetFontSizeCommand}"
                        CommandParameter="12"
                        Padding="6,3"
                        ToolTip.Tip="12 pt">
                  <TextBlock Text="12" Classes="mono-micro" />
                </Button>
                <Button Classes="linear-ghost"
                        Classes.active="{Binding IsFontSize16}"
                        Command="{Binding SetFontSizeCommand}"
                        CommandParameter="16"
                        Padding="6,3"
                        ToolTip.Tip="16 pt">
                  <TextBlock Text="16" Classes="mono-micro" />
                </Button>
                <Button Classes="linear-ghost"
                        Classes.active="{Binding IsFontSize20}"
                        Command="{Binding SetFontSizeCommand}"
                        CommandParameter="20"
                        Padding="6,3"
                        ToolTip.Tip="20 pt">
                  <TextBlock Text="20" Classes="mono-micro" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Context-Aware Floating Bottom Tool Dock & Navigation Pill -->
          <Border Classes="floating-toolbar"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding HasOpenDocument}">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

            <!-- PDF Toolset -->
            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsPdfWorkspaceActive}">
              <!-- Group 1: Select / Hand / Edit Text -->
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsSelectTool}"
                      Command="{Binding SetSelectToolCommand}"
                      ToolTip.Tip="Select &amp; Copy Text (V)">
                <Path Classes="icon-stroke" Data="{StaticResource IconPointer}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsHandTool}"
                      Command="{Binding SetHandToolCommand}"
                      ToolTip.Tip="Hand Pan (H)">
                <Path Classes="icon-stroke" Data="{StaticResource IconHand}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsEditTextTool}"
                      Command="{Binding SetEditTextToolCommand}"
                      ToolTip.Tip="Edit PDF Text Inline (E)">
                <Path Classes="icon-stroke" Data="{StaticResource IconEditText}" />
              </Button>

              <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="5,0" />

              <!-- Group 2: Markup & Annotations -->
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsHighlightTool}"
                      Command="{Binding SetHighlightToolCommand}"
                      ToolTip.Tip="Highlight (U)">
                <Path Classes="icon-stroke" Data="{StaticResource IconHighlight}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsUnderlineTool}"
                      Command="{Binding SetUnderlineToolCommand}"
                      ToolTip.Tip="Underline">
                <Path Classes="icon-stroke" Data="{StaticResource IconUnderline}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsDrawTool}"
                      Command="{Binding SetDrawToolCommand}"
                      ToolTip.Tip="Draw (P)">
                <Path Classes="icon-stroke" Data="{StaticResource IconPen}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsTextTool}"
                      Command="{Binding SetTextToolCommand}"
                      ToolTip.Tip="Text Box (T)">
                <Path Classes="icon-stroke" Data="{StaticResource IconType}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsNoteTool}"
                      Command="{Binding SetNoteToolCommand}"
                      ToolTip.Tip="Note (N)">
                <Path Classes="icon-stroke" Data="{StaticResource IconNote}" />
              </Button>

              <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="5,0" />

              <!-- Group 3: Redact / Sign -->
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsRedactTool}"
                      Command="{Binding SetRedactToolCommand}"
                      ToolTip.Tip="Redact (R)">
                <Path Classes="icon-stroke" Data="{StaticResource IconRedact}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding OpenSignatureModalCommand}"
                      IsEnabled="{Binding HasOpenDocument}"
                      ToolTip.Tip="Sign">
                <Path Classes="icon-stroke" Data="{StaticResource IconSignature}" />
              </Button>

              <!-- Contextual Apply Redactions Button -->
              <Button Classes="linear-accent"
                      Command="{Binding ApplyRedactionsAndSaveCommand}"
                      IsVisible="{Binding HasPendingRedactions}"
                      Margin="6,0,2,0"
                      Padding="10,4"
                      ToolTip.Tip="Permanently apply redactions and save">
                <TextBlock Text="Apply &amp; Save" Classes="type-micro" Foreground="{DynamicResource AccentTextBrush}" />
              </Button>

              <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="5,0" />

              <!-- Page Navigation -->
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding PreviousPageCommand}"
                      ToolTip.Tip="Previous Page">
                <Path Classes="icon-stroke" Data="{StaticResource IconChevronUp}" />
              </Button>
              <Button Classes="linear-ghost"
                      Command="{Binding BeginPageJumpCommand}"
                      IsVisible="{Binding !IsPageJumpEditing}"
                      Padding="6,4"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Jump to page">
                <TextBlock Text="{Binding PageCounterText}"
                           Classes="mono-num"
                           VerticalAlignment="Center" />
              </Button>
              <TextBox x:Name="PageJumpTextBox"
                       IsVisible="{Binding IsPageJumpEditing}"
                       Text="{Binding PageJumpInput, Mode=TwoWay}"
                       Width="56"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="12"
                       Padding="6,3"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       KeyDown="PageJumpTextBox_OnKeyDown"
                       LostFocus="PageJumpTextBox_OnLostFocus" />
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding NextPageCommand}"
                      ToolTip.Tip="Next Page">
                <Path Classes="icon-stroke" Data="{StaticResource IconChevronDown}" />
              </Button>

              <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="5,0" />

              <!-- Zoom -->
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding ZoomOutCommand}"
                      ToolTip.Tip="Zoom Out (Ctrl+-)">
                <Path Classes="icon-stroke" Data="{StaticResource IconZoomOut}" />
              </Button>
              <Button Classes="linear-ghost"
                      Command="{Binding ResetZoomCommand}"
                      Padding="6,4"
                      MinWidth="52"
                      HorizontalContentAlignment="Center"
                      ToolTip.Tip="Actual Size (Ctrl+0)">
                <TextBlock Text="{Binding ZoomText}" Classes="mono-num" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding ZoomInCommand}"
                      ToolTip.Tip="Zoom In (Ctrl+=)">
                <Path Classes="icon-stroke" Data="{StaticResource IconZoomIn}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding FitToWidthCommand}"
                      ToolTip.Tip="Fit Width (Alt+1)">
                <Path Classes="icon-stroke" Data="{StaticResource IconFitWidth}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Command="{Binding FitToPageCommand}"
                      ToolTip.Tip="Fit Page (Alt+2)">
                <Path Classes="icon-stroke" Data="{StaticResource IconFitPage}" />
              </Button>

              <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="5,0" />

              <!-- Panels -->
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsLeftPanelOpen}"
                      Command="{Binding ToggleLeftPanelCommand}"
                      ToolTip.Tip="Pages ([)">
                <Path Classes="icon-stroke" Data="{StaticResource IconPanelLeft}" />
              </Button>
              <Button Classes="linear-ghost icon-btn"
                      Classes.active="{Binding IsRightPanelOpen}"
                      Command="{Binding ToggleRightPanelCommand}"
                      ToolTip.Tip="Inspector (])">
                <Path Classes="icon-stroke" Data="{StaticResource IconPanelRight}" />
              </Button>
            </StackPanel>

            <!-- Spreadsheet Toolset -->
            <Panel IsVisible="{Binding IsSpreadsheetWorkspaceActive}">
              <StackPanel Orientation="Horizontal" Spacing="4"
                          DataContext="{Binding ActiveSpreadsheetTab}">
                <Button Classes="linear-ghost" Command="{Binding BeginCellEditCommand}" Height="28" Padding="8,0" ToolTip.Tip="Edit Cell (F2)">
                  <TextBlock Text="Edit Cell (F2)" FontSize="11.5" />
                </Button>
                <Button Classes="linear-ghost" Command="{Binding InsertRowBelowCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="+ Row" FontSize="11.5" />
                </Button>
                <Button Classes="linear-ghost" Command="{Binding DeleteSelectedRowCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="- Row" FontSize="11.5" />
                </Button>
                <Button Classes="linear-ghost" Command="{Binding InsertColumnRightCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="+ Col" FontSize="11.5" />
                </Button>
                <Button Classes="linear-ghost" Command="{Binding DeleteSelectedColumnCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="- Col" FontSize="11.5" />
                </Button>
                <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="3,0" />
                <Button Classes="linear-ghost" Command="{Binding SortAscendingCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="Sort A→Z" FontSize="11.5" />
                </Button>
                <Button Classes="linear-ghost" Command="{Binding SortDescendingCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="Sort Z→A" FontSize="11.5" />
                </Button>
              </StackPanel>
            </Panel>

            <!-- Rich Document (.docx) Toolset -->
            <Panel IsVisible="{Binding IsRichDocWorkspaceActive}">
              <StackPanel Orientation="Horizontal" Spacing="4"
                          DataContext="{Binding ActiveRichDocTab}">
                <Button Classes="linear-ghost" Classes.active="{Binding IsHeadingActive}" Command="{Binding CycleHeadingCommand}" Height="28" Padding="9,0">
                  <TextBlock Text="{Binding HeadingLabel}" FontSize="11.5" FontWeight="SemiBold" />
                </Button>
                <Button Classes="linear-ghost" Classes.active="{Binding IsBoldActive}" Command="{Binding ToggleBoldCommand}" Width="28" Height="28">
                  <TextBlock Text="B" FontWeight="Bold" FontSize="12" />
                </Button>
                <Button Classes="linear-ghost" Classes.active="{Binding IsItalicActive}" Command="{Binding ToggleItalicCommand}" Width="28" Height="28">
                  <TextBlock Text="I" FontStyle="Italic" FontSize="12" />
                </Button>
                <Button Classes="linear-ghost" Classes.active="{Binding IsUnderlineActive}" Command="{Binding ToggleUnderlineCommand}" Width="28" Height="28">
                  <TextBlock Text="U" TextDecorations="Underline" FontSize="12" />
                </Button>
                <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="3,0" />
                <Button Classes="linear-ghost" Classes.active="{Binding IsBulletActive}" Command="{Binding ToggleBulletListCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="• Bullet" FontSize="11.5" />
                </Button>
                <Button Classes="linear-ghost" Classes.active="{Binding IsNumberedActive}" Command="{Binding ToggleNumberedListCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="1. List" FontSize="11.5" />
                </Button>
                <Button Classes="linear-ghost" Command="{Binding InsertTableCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="+ Table" FontSize="11.5" />
                </Button>
              </StackPanel>
            </Panel>

            <!-- Markdown & Code Toolset -->
            <Panel IsVisible="{Binding IsMarkdownWorkspaceActive}">
              <StackPanel Orientation="Horizontal" Spacing="4"
                          DataContext="{Binding ActiveMarkdownTab}">
                <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsMarkdownFile}">
                  <Button Classes="linear-ghost" Classes.active="{Binding IsEditorMode}" Command="{Binding SetEditorModeCommand}" Height="28" Padding="9,0">
                    <TextBlock Text="Editor" FontSize="11.5" />
                  </Button>
                  <Button Classes="linear-ghost" Classes.active="{Binding IsSplitMode}" Command="{Binding SetSplitPreviewModeCommand}" Height="28" Padding="9,0">
                    <TextBlock Text="Split" FontSize="11.5" />
                  </Button>
                  <Button Classes="linear-ghost" Classes.active="{Binding IsReaderMode}" Command="{Binding SetCleanReaderModeCommand}" Height="28" Padding="9,0">
                    <TextBlock Text="Reader" FontSize="11.5" />
                  </Button>
                  <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="3,0" />
                </StackPanel>
                <Button Classes="linear-ghost" Classes.active="{Binding WordWrap}" Command="{Binding ToggleWordWrapCommand}" Height="28" Padding="9,0">
                  <TextBlock Text="Word Wrap" FontSize="11.5" />
                </Button>
              </StackPanel>
            </Panel>

            <!-- Image Viewer & Editor Toolset -->
            <Panel IsVisible="{Binding IsImageWorkspaceActive}">
              <StackPanel Orientation="Horizontal" Spacing="3"
                          DataContext="{Binding ActiveImageTab}">
                <Button Classes="linear-ghost icon-btn" Command="{Binding Rotate90CcwCommand}" ToolTip.Tip="Rotate 90° Left">
                  <Path Classes="icon-stroke" Data="{StaticResource IconRotateCcw}" />
                </Button>
                <Button Classes="linear-ghost icon-btn" Command="{Binding Rotate90CwCommand}" ToolTip.Tip="Rotate 90° Right">
                  <Path Classes="icon-stroke" Data="{StaticResource IconRotateCw}" />
                </Button>
                <Button Classes="linear-ghost icon-btn" Command="{Binding FlipHorizontalCommand}" ToolTip.Tip="Flip Horizontal">
                  <Path Classes="icon-stroke" Data="{StaticResource IconFlipH}" />
                </Button>
                <Button Classes="linear-ghost icon-btn" Command="{Binding FlipVerticalCommand}" ToolTip.Tip="Flip Vertical">
                  <Path Classes="icon-stroke" Data="{StaticResource IconFlipV}" />
                </Button>
                <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="3,0" />
                <Button Classes="linear-ghost" Classes.active="{Binding IsCropping}" Command="{Binding ToggleCropModeCommand}" Height="28" Padding="8,0" ToolTip.Tip="Crop Image">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Classes="icon-stroke" Data="{StaticResource IconCrop}" Width="12" Height="12" />
                    <TextBlock Text="Crop" FontSize="11.5" />
                  </StackPanel>
                </Button>
                <Button Classes="linear-ghost" Command="{Binding OpenResizePanelCommand}" Height="28" Padding="8,0" ToolTip.Tip="Resize Image">
                  <TextBlock Text="Resize" FontSize="11.5" />
                </Button>
                <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="3,0" />
                <Button Classes="linear-ghost icon-btn" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out">
                  <Path Classes="icon-stroke" Data="{StaticResource IconZoomOut}" />
                </Button>
                <Button Classes="linear-ghost" Command="{Binding ResetZoomCommand}" Height="28" Padding="6,0" ToolTip.Tip="100%">
                  <TextBlock Text="{Binding ZoomPercent, StringFormat='{}{0}%'}" Classes="mono-num" />
                </Button>
                <Button Classes="linear-ghost icon-btn" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In">
                  <Path Classes="icon-stroke" Data="{StaticResource IconZoomIn}" />
                </Button>
                <Button Classes="linear-ghost" Command="{Binding FitToScreenCommand}" Height="28" Padding="8,0">
                  <TextBlock Text="Fit" FontSize="11.5" />
                </Button>
              </StackPanel>
            </Panel>

            <!-- Shared Quick Save & Export PDF (for non-PDF editors) -->
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsPdfWorkspaceActive}">
              <Border Width="1" Height="16" Background="{DynamicResource HairlineBorderBrush}" Margin="4,0" />
              <Button Classes="save-pill"
                      Classes.dirty="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasUnsavedChanges}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveDocumentCommand}"
                      Height="26"
                      Padding="10,2">
                <TextBlock Text="Save" FontSize="11.5" />
              </Button>
              <Button Classes="linear-surface"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportToPdfCommand}"
                      Height="26"
                      Padding="10,2">
                <TextBlock Text="Export PDF" FontSize="11.5" />
              </Button>
            </StackPanel>
          </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Right Collapsible Inspector Panel (260px, PDF only) -->
      <Border Grid.Column="2"
              IsVisible="{Binding IsPdfWorkspaceActive}"
              Classes="sidebar-right"
              Classes.collapsed="{Binding !IsRightPanelOpen}"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource HairlineBorderBrush}"
              BorderThickness="1,0,0,0"
              ClipToBounds="True">
        <ScrollViewer Width="260" Padding="16">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="Inspector" Classes="type-section" />
              <TextBlock Text="{Binding StatusMessage}" Classes="type-micro" TextWrapping="Wrap" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource HairlineBorderBrush}" />

            <!-- Page Info -->
            <StackPanel Spacing="8">
              <TextBlock Text="PAGE" Classes="type-micro" />
              <Border Background="{DynamicResource PanelSubtleBackgroundBrush}"
                      BorderBrush="{DynamicResource HairlineBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Padding="12,10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" Classes="type-micro" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActivePageSizeLabel}" Classes="mono-num" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Zoom" Classes="type-micro" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ZoomText}" Classes="mono-num" />
                </Grid>
              </Border>
            </StackPanel>

            <!-- Selected Annotation / Pending Redactions -->
            <StackPanel Spacing="8" IsVisible="{Binding HasSelectedAnnotation}">
              <Border Height="1" Background="{DynamicResource HairlineBorderBrush}" />
              <TextBlock Text="ANNOTATION" Classes="type-micro" />
              <TextBox Text="{Binding SelectedAnnotationText}"
                       IsVisible="{Binding HasSelectedEditableText}"
                       PlaceholderText="Enter text…"
                       AcceptsReturn="True"
                       MinHeight="56"
                       FontSize="12" />
              <Button Classes="linear-surface"
                      Command="{Binding DeleteSelectedAnnotationCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center">
                <TextBlock Text="Delete" Classes="type-micro" Foreground="{DynamicResource DangerBrush}" />
              </Button>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasPendingRedactions}">
              <Border Height="1" Background="{DynamicResource HairlineBorderBrush}" />
              <TextBlock Text="REDACTION" Classes="type-micro" />
              <Button Classes="linear-accent"
                      Command="{Binding ApplyRedactionsAndSaveCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center">
                <TextBlock Text="Apply &amp; Save" VerticalAlignment="Center" />
              </Button>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource HairlineBorderBrush}" />

            <!-- Page Actions -->
            <StackPanel Spacing="8" IsEnabled="{Binding HasOpenDocument}">
              <TextBlock Text="PAGES" Classes="type-micro" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Classes="linear-surface"
                        Command="{Binding RotateSelectedLeftCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Ctrl+Shift+L">
                  <TextBlock Text="Rotate Left" Classes="type-micro" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Button>
                <Button Grid.Column="1"
                        Classes="linear-surface"
                        Command="{Binding RotateSelectedRightCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Ctrl+Shift+R">
                  <TextBlock Text="Rotate Right" Classes="type-micro" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Button>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Classes="linear-surface"
                        Command="{Binding ExtractSelectedPageCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                  <TextBlock Text="Extract" Classes="type-micro" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Button>
                <Button Grid.Column="1"
                        Classes="linear-surface"
                        Command="{Binding MergeDocumentsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                  <TextBlock Text="Merge" Classes="type-micro" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Button>
              </Grid>

              <Button Classes="linear-surface"
                      Command="{Binding DeleteSelectedPageCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      ToolTip.Tip="Del">
                <TextBlock Text="Delete Page" Classes="type-micro" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Button>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource HairlineBorderBrush}" />

            <!-- Forms, Signature & Security -->
            <StackPanel Spacing="8" IsEnabled="{Binding HasOpenDocument}">
              <TextBlock Text="FORMS &amp; SECURITY" Classes="type-micro" />

              <Button Classes="linear-surface"
                      Command="{Binding OpenSignatureModalCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon-stroke" Data="{StaticResource IconSignature}" Width="14" Height="14" />
                  <TextBlock Text="Signature…" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <CheckBox IsChecked="{Binding FlattenFormsOnSave}"
                        Content="Flatten Forms"
                        FontSize="12" />

              <CheckBox IsChecked="{Binding ProtectWithPassword}"
                        Content="Protect with Password"
                        FontSize="12" />

              <TextBox Text="{Binding DocumentPassword}"
                       IsVisible="{Binding ProtectWithPassword}"
                       PasswordChar="•"
                       PlaceholderText="AES-256 Password"
                       FontSize="12" />

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                <Button Grid.Column="0"
                        Classes="linear-surface"
                        Command="{Binding UndoCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Undo (Ctrl+Z)">
                  <TextBlock Text="Undo" Classes="type-micro" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Button>
                <Button Grid.Column="1"
                        Classes="linear-surface"
                        Command="{Binding RedoCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Redo (Ctrl+Y)">
                  <TextBlock Text="Redo" Classes="type-micro" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Button>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Classes="linear-accent"
                        Command="{Binding SaveDocumentCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Save (Ctrl+S)">
                  <TextBlock Text="Save" VerticalAlignment="Center" />
                </Button>
                <Button Grid.Column="1"
                        Classes="linear-surface"
                        Command="{Binding SaveDocumentAsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Save As (Ctrl+Shift+S)">
                  <TextBlock Text="Save As" Classes="type-micro" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Button>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Signature Modal -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Classes="modal-overlay"
          Classes.open="{Binding IsSignatureModalOpen}">
      <Border Background="{DynamicResource ModalScrimBrush}"
              PointerPressed="SignatureBackdrop_OnPointerPressed" />

      <Border Classes="modal-card"
              Width="480"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Background="{DynamicResource FloatingToolbarBrush}"
              BorderBrush="{DynamicResource FloatingBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource FloatingCornerRadius}"
              BoxShadow="{DynamicResource ModalDialogShadow}"
              Padding="20">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Signature" Classes="type-section" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="linear-ghost icon-btn"
                    Command="{Binding CloseSignatureModalCommand}">
              <Path Classes="icon-stroke" Data="{StaticResource IconCloseWin}" Width="12" Height="12" />
            </Button>
          </Grid>

          <Border Background="#FFFFFF"
                  BorderBrush="{DynamicResource HairlineBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource ControlCornerRadius}"
                  Height="180"
                  ClipToBounds="True">
            <Canvas x:Name="SignaturePadCanvas"
                    Background="#FFFFFF"
                    Cursor="Cross"
                    PointerPressed="SignaturePad_OnPointerPressed"
                    PointerMoved="SignaturePad_OnPointerMoved"
                    PointerReleased="SignaturePad_OnPointerReleased" />
          </Border>

          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Grid.Column="0"
                    Classes="linear-surface"
                    Command="{Binding ClearSignaturePadCommand}"
                    Margin="0,0,8,0">
              <TextBlock Text="Clear" />
            </Button>
            <Button Grid.Column="1"
                    Classes="linear-surface"
                    Command="{Binding ImportSignaturePngCommand}">
              <TextBlock Text="Import PNG" />
            </Button>
            <Button Grid.Column="3"
                    Classes="linear-accent"
                    Click="PlaceDrawnSignature_OnClick">
              <TextBlock Text="Place Signature" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Open Password Prompt Modal -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Classes="modal-overlay"
          Classes.open="{Binding IsOpenPasswordPromptOpen}">
      <Border Background="{DynamicResource ModalScrimBrush}" />

      <Border Classes="modal-card"
              Width="360"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Background="{DynamicResource FloatingToolbarBrush}"
              BorderBrush="{DynamicResource FloatingBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource FloatingCornerRadius}"
              BoxShadow="{DynamicResource ModalDialogShadow}"
              Padding="20">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Path Classes="icon-stroke" Data="{StaticResource IconLock}" Width="16" Height="16" />
            <TextBlock Text="Password Required" Classes="type-section" />
          </StackPanel>

          <TextBox Text="{Binding OpenPasswordInput}"
                   PasswordChar="•"
                   PlaceholderText="Enter password"
                   KeyDown="OpenPasswordBox_OnKeyDown" />

          <TextBlock Text="{Binding OpenPasswordError}"
                     Classes="type-micro"
                     Foreground="{DynamicResource DangerBrush}"
                     IsVisible="{Binding OpenPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="linear-surface" Command="{Binding CancelOpenPasswordCommand}">
              <TextBlock Text="Cancel" />
            </Button>
            <Button Classes="linear-accent" Command="{Binding SubmitOpenPasswordCommand}">
              <TextBlock Text="Unlock" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Command Palette Modal -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Classes="modal-overlay"
          Classes.open="{Binding IsCommandPaletteOpen}">
      <Border Background="{DynamicResource ModalScrimBrush}"
              PointerPressed="ModalBackdrop_OnPointerPressed" />

      <Border Classes="modal-card"
              Width="500"
              VerticalAlignment="Top"
              Margin="0,84,0,0"
              Background="{DynamicResource FloatingToolbarBrush}"
              BorderBrush="{DynamicResource FloatingBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource FloatingCornerRadius}"
              BoxShadow="{DynamicResource ModalDialogShadow}">
        <StackPanel>
          <Border Padding="14,12"
                  BorderBrush="{DynamicResource HairlineBorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0"
                    Classes="icon-stroke"
                    Data="{StaticResource IconSearch}"
                    Stroke="{DynamicResource TextSecondaryBrush}"
                    VerticalAlignment="Center" />
              <TextBox Grid.Column="1"
                       x:Name="CommandSearchBox"
                       Text="{Binding CommandSearchQuery}"
                       PlaceholderText="Search commands…"
                       Background="Transparent"
                       BorderThickness="0"
                       FontSize="13"
                       Margin="10,0"
                       VerticalAlignment="Center" />
              <Border Grid.Column="2"
                      Background="{DynamicResource PanelSubtleBackgroundBrush}"
                      BorderBrush="{DynamicResource HairlineBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource BadgeCornerRadius}"
                      Padding="6,2"
                      VerticalAlignment="Center">
                <TextBlock Text="ESC" Classes="mono-micro" FontSize="10" />
              </Border>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding FilteredCommands}" Margin="8" MaxHeight="340">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CommandPaletteItem">
                <Button Classes="linear-ghost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExecutePaletteCommandCommand}"
                        CommandParameter="{Binding}"
                        Padding="10,8">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Category}"
                               Classes="type-micro"
                               Width="72"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               Classes="type-body"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="2"
                            Background="{DynamicResource PanelSubtleBackgroundBrush}"
                            BorderBrush="{DynamicResource HairlineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource BadgeCornerRadius}"
                            Padding="6,2"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Shortcut}" Classes="mono-micro" FontSize="10" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- VS Code-Style Theme Picker Popover -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Classes="modal-overlay"
          Classes.open="{Binding IsThemePickerOpen}">
      <Border Background="Transparent"
              PointerPressed="ThemePickerBackdrop_OnPointerPressed" />

      <Border Classes="modal-card"
              Width="316"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,44,16,0"
              Background="{DynamicResource FloatingToolbarBrush}"
              BorderBrush="{DynamicResource FloatingBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource FloatingCornerRadius}"
              BoxShadow="{DynamicResource ModalDialogShadow}"
              Padding="14">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Theme" Classes="type-section" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="linear-ghost icon-btn"
                    Command="{Binding CloseThemePickerCommand}">
              <Path Classes="icon-stroke" Data="{StaticResource IconCloseWin}" Width="12" Height="12" />
            </Button>
          </Grid>

          <!-- Light Themes -->
          <StackPanel Spacing="4">
            <TextBlock Text="LIGHT" Classes="type-micro" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,0,2" />
            <ItemsControl ItemsSource="{Binding LightThemeOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="themes:ThemeOptionViewModel">
                  <Button Classes="linear-ghost"
                          Classes.active="{Binding IsSelected}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectThemeCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Padding="8,7">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Border Width="11" Height="11" CornerRadius="3" Background="{Binding DeskBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" />
                        <Border Width="11" Height="11" CornerRadius="3" Background="{Binding SidebarBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" />
                        <Border Width="11" Height="11" CornerRadius="3" Background="{Binding ToolbarBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" />
                        <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Classes="type-control" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding CategoryLabel}" Classes="type-micro" Foreground="{DynamicResource TextTertiaryBrush}" />
                      </StackPanel>
                      <Path Grid.Column="2"
                            Classes="icon-stroke"
                            Data="{StaticResource IconCheck}"
                            Width="14"
                            Height="14"
                            IsVisible="{Binding IsSelected}"
                            VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource HairlineBorderBrush}" />

          <!-- Dark Themes -->
          <StackPanel Spacing="4">
            <TextBlock Text="DARK" Classes="type-micro" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,0,2" />
            <ItemsControl ItemsSource="{Binding DarkThemeOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="themes:ThemeOptionViewModel">
                  <Button Classes="linear-ghost"
                          Classes.active="{Binding IsSelected}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectThemeCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Padding="8,7">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Border Width="11" Height="11" CornerRadius="3" Background="{Binding DeskBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" />
                        <Border Width="11" Height="11" CornerRadius="3" Background="{Binding SidebarBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" />
                        <Border Width="11" Height="11" CornerRadius="3" Background="{Binding ToolbarBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" />
                        <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Classes="type-control" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding CategoryLabel}" Classes="type-micro" Foreground="{DynamicResource TextTertiaryBrush}" />
                      </StackPanel>
                      <Path Grid.Column="2"
                            Classes="icon-stroke"
                            Data="{StaticResource IconCheck}"
                            Width="14"
                            Height="14"
                            IsVisible="{Binding IsSelected}"
                            VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Unsaved Changes Confirmation Modal -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Classes="modal-overlay"
          Classes.open="{Binding IsUnsavedChangesModalOpen}">
      <Border Background="{DynamicResource ModalScrimBrush}" />
      <Border Classes="modal-card"
              Width="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource FloatingToolbarBrush}"
              BorderBrush="{DynamicResource FloatingBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource FloatingCornerRadius}"
              BoxShadow="{DynamicResource ModalDialogShadow}"
              Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding PendingCloseTabTitle, StringFormat='Save changes to {0}?'}"
                     Classes="type-section"
                     TextWrapping="Wrap" />
          <TextBlock Text="Your changes will be lost if you close this tab without saving."
                     Classes="type-micro"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="linear-surface"
                    Command="{Binding CancelCloseTabCommand}">
              <TextBlock Text="Cancel" />
            </Button>
            <Button Classes="linear-surface"
                    Command="{Binding ConfirmDiscardAndCloseTabCommand}">
              <TextBlock Text="Don't Save" />
            </Button>
            <Button Classes="linear-accent"
                    Command="{Binding ConfirmSaveAndCloseTabCommand}">
              <TextBlock Text="Save" Foreground="{DynamicResource AccentTextBrush}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Friendly Error Modal -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Classes="modal-overlay"
          Classes.open="{Binding IsErrorModalOpen}">
      <Border Background="{DynamicResource ModalScrimBrush}" />
      <Border Classes="modal-card"
              Width="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource FloatingToolbarBrush}"
              BorderBrush="{DynamicResource FloatingBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource FloatingCornerRadius}"
              BoxShadow="{DynamicResource ModalDialogShadow}"
              Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="Something went wrong" Classes="type-section" />
          <TextBlock Text="{Binding ErrorModalMessage}"
                     Classes="type-control"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
          <Button Classes="linear-accent"
                  Command="{Binding CloseErrorModalCommand}"
                  HorizontalAlignment="Right"
                  Padding="18,6">
            <TextBlock Text="OK" Foreground="{DynamicResource AccentTextBrush}" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- New / Open Tab Quick Menu (Ctrl+T or '+' button) -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Classes="modal-overlay"
          Classes.open="{Binding IsNewTabMenuOpen}">
      <Border Background="Transparent" PointerPressed="NewTabBackdrop_OnPointerPressed" />
      <Border Classes="modal-card"
              Width="250"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,44,0,0"
              Background="{DynamicResource FloatingToolbarBrush}"
              BorderBrush="{DynamicResource FloatingBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource FloatingCornerRadius}"
              BoxShadow="{DynamicResource ModalDialogShadow}"
              Padding="8">
        <StackPanel Spacing="2">
          <TextBlock Text="NEW OR OPEN TAB" Classes="type-micro" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,4,8,4" />
          <Button Classes="linear-ghost" Command="{Binding OpenDocumentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Open File…" FontSize="12.5" />
              <TextBlock Grid.Column="1" Text="Ctrl+O" Classes="mono-micro" Foreground="{DynamicResource TextTertiaryBrush}" />
            </Grid>
          </Button>
          <Border Height="1" Background="{DynamicResource HairlineBorderBrush}" Margin="4,4" />
          <Button Classes="linear-ghost" Command="{Binding NewMarkdownDocumentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6">
            <TextBlock Text="New Markdown (.md)" FontSize="12.5" />
          </Button>
          <Button Classes="linear-ghost" Command="{Binding NewSpreadsheetDocumentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6">
            <TextBlock Text="New Spreadsheet (.xlsx)" FontSize="12.5" />
          </Button>
          <Button Classes="linear-ghost" Command="{Binding NewRichDocumentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6">
            <TextBlock Text="New Word Document (.docx)" FontSize="12.5" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- All Open Tabs Search Dropdown (Ctrl+Shift+A or 'v' button) -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Classes="modal-overlay"
          Classes.open="{Binding IsAllTabsDropdownOpen}">
      <Border Background="Transparent" PointerPressed="AllTabsBackdrop_OnPointerPressed" />
      <Border Classes="modal-card"
              Width="440"
              MaxHeight="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,44,0,0"
              Background="{DynamicResource FloatingToolbarBrush}"
              BorderBrush="{DynamicResource FloatingBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource FloatingCornerRadius}"
              BoxShadow="{DynamicResource ModalDialogShadow}"
              Padding="12">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*">
            <Path Classes="icon-stroke" Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="4,0,8,0" VerticalAlignment="Center" />
            <TextBox x:Name="TabSearchInput"
                     Grid.Column="1"
                     Text="{Binding TabSearchQuery, Mode=TwoWay}"
                     PlaceholderText="Search open tabs by name, path, or format…"
                     FontSize="12.5" />
          </Grid>

          <ScrollViewer MaxHeight="320">
            <ItemsControl ItemsSource="{Binding FilteredOpenTabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DocumentTabViewModel">
                  <Button Classes="linear-ghost"
                          Classes.active="{Binding IsActive}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectTabFromDropdownCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Padding="8,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <Border Grid.Column="0"
                              Background="{Binding FormatBadgeBackgroundBrush}"
                              CornerRadius="4"
                              Padding="5,1"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding FormatBadgeText}"
                                   Foreground="{Binding FormatBadgeBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding OriginalFilePath}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding MicroMetadataBadge}" Classes="mono-micro" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
