<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfStudio.App.ViewModels"
             x:Class="PdfStudio.App.Views.Editors.RichDocEditorView"
             x:DataType="vm:RichDocWorkspaceViewModel"
             Background="{DynamicResource CanvasBackgroundBrush}">
  <Grid RowDefinitions="42,*">
    <!-- Contextual Formatting Bar -->
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource HairlineBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,0">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Command="{Binding CycleHeadingCommand}"
                Classes="linear-ghost"
                Classes.active="{Binding IsHeadingActive}"
                ToolTip.Tip="Cycle Heading Style (Body / H1 / H2 / H3)"
                Height="28"
                Padding="10,0">
          <TextBlock Text="{Binding HeadingLabel}" FontSize="12" FontWeight="SemiBold" />
        </Button>

        <Border Width="1" Height="18" Background="{DynamicResource HairlineBorderBrush}" Margin="2,0" />

        <Button Command="{Binding ToggleBoldCommand}"
                Classes="linear-ghost"
                Classes.active="{Binding IsBoldActive}"
                ToolTip.Tip="Bold"
                Width="30"
                Height="28">
          <TextBlock Text="B" FontWeight="Bold" FontSize="13" />
        </Button>

        <Button Command="{Binding ToggleItalicCommand}"
                Classes="linear-ghost"
                Classes.active="{Binding IsItalicActive}"
                ToolTip.Tip="Italic"
                Width="30"
                Height="28">
          <TextBlock Text="I" FontStyle="Italic" FontSize="13" />
        </Button>

        <Button Command="{Binding ToggleUnderlineCommand}"
                Classes="linear-ghost"
                Classes.active="{Binding IsUnderlineActive}"
                ToolTip.Tip="Underline"
                Width="30"
                Height="28">
          <TextBlock Text="U" TextDecorations="Underline" FontSize="13" />
        </Button>

        <Border Width="1" Height="18" Background="{DynamicResource HairlineBorderBrush}" Margin="2,0" />

        <Button Command="{Binding ToggleBulletListCommand}"
                Classes="linear-ghost"
                Classes.active="{Binding IsBulletActive}"
                ToolTip.Tip="Bullet List"
                Height="28"
                Padding="10,0">
          <TextBlock Text="• List" FontSize="12" />
        </Button>

        <Button Command="{Binding ToggleNumberedListCommand}"
                Classes="linear-ghost"
                Classes.active="{Binding IsNumberedActive}"
                ToolTip.Tip="Numbered List"
                Height="28"
                Padding="10,0">
          <TextBlock Text="1. List" FontSize="12" />
        </Button>

        <Border Width="1" Height="18" Background="{DynamicResource HairlineBorderBrush}" Margin="2,0" />

        <Button Command="{Binding AddParagraphAfterCommand}"
                Classes="linear-ghost"
                ToolTip.Tip="Add Paragraph Block"
                Height="28"
                Padding="10,0">
          <TextBlock Text="+ Paragraph" FontSize="12" />
        </Button>

        <Button Command="{Binding InsertTableCommand}"
                Classes="linear-ghost"
                ToolTip.Tip="Insert Table"
                Height="28"
                Padding="10,0">
          <TextBlock Text="+ Table" FontSize="12" />
        </Button>

        <Button Command="{Binding AddTableRowCommand}"
                IsVisible="{Binding IsTableSelected}"
                Classes="linear-ghost"
                Height="28"
                Padding="8,0">
          <TextBlock Text="+ Row" FontSize="11.5" />
        </Button>

        <Button Command="{Binding AddTableColumnCommand}"
                IsVisible="{Binding IsTableSelected}"
                Classes="linear-ghost"
                Height="28"
                Padding="8,0">
          <TextBlock Text="+ Col" FontSize="11.5" />
        </Button>

        <Button Command="{Binding DeleteSelectedBlockCommand}"
                Classes="linear-ghost"
                ToolTip.Tip="Delete Selected Block"
                Height="28"
                Padding="8,0">
          <TextBlock Text="Remove" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Document Paper Canvas -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Padding="24,24,24,84">
      <Border MaxWidth="820"
              MinHeight="960"
              HorizontalAlignment="Center"
              Background="{DynamicResource FloatingToolbarBrush}"
              BorderBrush="{DynamicResource HairlineBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="56,48">
        <ItemsControl ItemsSource="{Binding Blocks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RichDocBlockViewModel">
              <Border Margin="{Binding BlockMargin}"
                      Padding="6,3"
                      CornerRadius="4"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource HairlineBorderBrush}"
                      Classes.selected-block="{Binding IsSelected}">
                <Grid>
                  <!-- Text / Heading / List Block -->
                  <Grid ColumnDefinitions="Auto,*"
                        IsVisible="{Binding IsTextBlock}">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ListPrefix}"
                               FontSize="{Binding BlockFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,4,10,0"
                               VerticalAlignment="Top"
                               IsVisible="{Binding IsBullet}" />
                    <TextBlock Grid.Column="0"
                               Text="{Binding ListPrefix}"
                               FontSize="{Binding BlockFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,4,10,0"
                               VerticalAlignment="Top"
                               IsVisible="{Binding IsNumbered}" />

                    <Grid Grid.Column="1">
                      <TextBox Text="{Binding Text, Mode=TwoWay}"
                               FontSize="{Binding BlockFontSize}"
                               FontWeight="{Binding BlockFontWeight}"
                               FontStyle="{Binding BlockFontStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Background="Transparent"
                               BorderThickness="0"
                               Padding="2,2"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               PlaceholderText="Type here…"
                               GotFocus="OnBlockControlGotFocus" />
                      <Border Height="1.5"
                              Background="{DynamicResource TextPrimaryBrush}"
                              Opacity="0.72"
                              Margin="2,0,2,2"
                              VerticalAlignment="Bottom"
                              IsHitTestVisible="False"
                              IsVisible="{Binding IsUnderline}" />
                    </Grid>
                  </Grid>

                  <!-- Editable Table Block -->
                  <Border IsVisible="{Binding IsTableBlock}"
                          BorderBrush="{DynamicResource HairlineBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Padding="4"
                          GotFocus="OnBlockControlGotFocus">
                    <ItemsControl ItemsSource="{Binding TableRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RichDocTableRowViewModel">
                          <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:RichDocTableCellViewModel">
                                <Border BorderBrush="{DynamicResource HairlineBorderBrush}"
                                        BorderThickness="0.5"
                                        Padding="4,2">
                                  <TextBox Text="{Binding Text, Mode=TwoWay}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           TextWrapping="Wrap"
                                           GotFocus="OnTableCellGotFocus" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
