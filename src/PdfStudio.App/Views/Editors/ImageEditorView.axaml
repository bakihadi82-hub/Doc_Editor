<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PdfStudio.App.Controls"
             xmlns:vm="using:PdfStudio.App.ViewModels"
             x:Class="PdfStudio.App.Views.Editors.ImageEditorView"
             x:DataType="vm:ImageWorkspaceViewModel"
             Background="{DynamicResource CanvasBackgroundBrush}">
  <Grid>
    <controls:ImageCanvasControl x:Name="ImgCanvas" />

    <!-- Crop Confirmation Floating Bar -->
    <Border IsVisible="{Binding IsCropping}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,14,0,0"
            Background="{DynamicResource FloatingToolbarBrush}"
            BorderBrush="{DynamicResource FloatingBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="{DynamicResource FloatingPanelShadow}"
            Padding="12,6">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Drag on image to select crop region"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" />
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
          <Run Text="{Binding CropWidth}" />
          <Run Text="×" />
          <Run Text="{Binding CropHeight}" />
          <Run Text=" px" />
        </TextBlock>
        <Button Content="Apply Crop"
                Command="{Binding ApplyCropCommand}"
                Classes="linear-accent"
                Height="26"
                Padding="10,0" />
        <Button Content="Cancel"
                Command="{Binding CancelCropCommand}"
                Classes="linear-ghost"
                Height="26"
                Padding="10,0" />
      </StackPanel>
    </Border>

    <!-- Resize Popover Modal -->
    <Border IsVisible="{Binding IsResizePanelOpen}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="300"
            Background="{DynamicResource FloatingToolbarBrush}"
            BorderBrush="{DynamicResource FloatingBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            BoxShadow="{DynamicResource ModalDialogShadow}"
            Padding="18">
      <StackPanel Spacing="12">
        <TextBlock Text="Resize Image" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="W" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Value="{Binding ResizeWidth}" Minimum="1" Maximum="16000" FormatString="0" />
          <TextBlock Grid.Column="2" Text="H" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="3" Value="{Binding ResizeHeight}" Minimum="1" Maximum="16000" FormatString="0" />
        </Grid>

        <CheckBox IsChecked="{Binding LockAspectRatio}" Content="Lock aspect ratio" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelResizeCommand}" Classes="linear-surface" Height="28" Padding="12,0" />
          <Button Content="Apply" Command="{Binding ApplyResizeCommand}" Classes="linear-accent" Height="28" Padding="12,0" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
